# ─────────────────────────────────────────────────────────────
# H2NODE Auth — variáveis de ambiente
# Copie para .env e ajuste os valores. NUNCA versione o .env real.
# ─────────────────────────────────────────────────────────────

# ---- Volumes ----
# Prefixo dos volumes do Docker (banco, backups, logs, config do TACACS+).
# Instalação nova: deixe assim. Vinda do Pulse RADIUS: VOLUME_PREFIX=pulse-radius
# (scripts/migrar-h2node.sh acrescenta sozinho).
VOLUME_PREFIX=h2node-auth

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=radius
# Usuário usado pelo backend (CRUD completo nas tabelas app_* e radius)
MYSQL_BACKEND_USER=backend_svc
MYSQL_BACKEND_PASSWORD=change-me-backend
# Usuário usado pelo FreeRADIUS (leitura de auth + escrita de accounting)
MYSQL_RADIUS_USER=radius_svc
MYSQL_RADIUS_PASSWORD=change-me-radius

# ---- Redis (storage do rate-limit, compartilhado entre workers) ----
REDIS_PASSWORD=change-me-redis

# ---- Backend (FastAPI) ----
# Chave de assinatura dos JWT — MÍNIMO 32 caracteres (openssl rand -hex 32)
JWT_SECRET=change-me-jwt-secret-32-bytes-hex
# Chave Fernet para cifrar segredos em repouso (radius_secret, mfa_secret)
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-fernet-key-base64
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# "Lembrar deste dispositivo" no 2FA: dias que um navegador fica dispensado da
# 2ª etapa (janela deslizante, renovada a cada login). 0 desativa o recurso.
MFA_TRUSTED_DEVICE_TTL_DAYS=30
# URL pública pela qual o painel é acessado (a que o Nginx Proxy Manager publica).
# Usada no CORS. Ex.: https://radius.suaempresa.com.br
FRONTEND_ORIGIN=https://radius.example.com
# Mantenha true: o proxy externo (NPM) entrega HTTPS ao navegador.
COOKIE_SECURE=true
# IP(s)/CIDR(s) do reverse proxy externo confiável (separados por vírgula): só
# deles o frontend aceita X-Forwarded-For. "*" = faixas privadas (10/8, 172.16/12,
# 192.168/16). Em produção: use o IP do servidor do NPM e configure o NPM para
# SUBSTITUIR o X-Forwarded-For (proxy_set_header X-Forwarded-For $remote_addr).
FORWARDED_ALLOW_IPS=*
# Expor /api/docs e /api/openapi.json. Deixe false em produção.
ENABLE_DOCS=false
LOG_LEVEL=INFO

# ---- Primeiro utilizador do painel (criado pelo seed) ----
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-strong

# ---- MySQL (acesso local de freeradius/tacacs, que usam a rede do host) ----
# Publicado só em 127.0.0.1. Mude se já houver um MySQL no host usando a 3306.
DB_LOCAL_PORT=3306

# ---- FreeRADIUS ----
# Segredo do cliente de teste 127.0.0.1 (radtest local)
RADIUS_TEST_SECRET=testing123
# Os equipamentos apontam para  <IP-privado-do-servidor>:1812 (auth) e :1813 (acct).
# O container usa network_mode: host (escuta direto no host); restrinja a origem com
# `ufw allow from <rede> to any port 1812:1813 proto udp` (RADIUS_BIND não é mais usado).
# BlastRADIUS: "auto" exige Message-Authenticator de quem já envia; "yes" de todos.
RADIUS_REQUIRE_MA=auto

# ---- TACACS+ (tac_plus-ng) ----
# Equipamentos Huawei/Juniper/Datacom/A10 que falam TACACS+ apontam para
# <IP-privado-do-servidor>:49/tcp. Container em network_mode: host; restrinja a origem
# com `ufw allow from <rede> to any port 49 proto tcp` (TACACS_BIND não é mais usado).
# Opcional: IP deste servidor, mostrado como "IP de destino" das tentativas
# de login TACACS+ na tela Authentication (o access.log não traz esse campo).
TACACS_SERVER_IP=

# ---- Publicação HTTP (atrás do Nginx Proxy Manager) ----
# Porta em que a aplicação (SPA + /api) escuta no host. Aponte o NPM para
# http://<IP-privado-do-servidor>:${WEB_PORT}
WEB_PORT=8080
# Interface onde publicar. Deixe 0.0.0.0 ou fixe no IP privado do servidor.
WEB_BIND=0.0.0.0

# ---- Proxy TLS embutido (só se usar --profile tls-proxy, sem NPM) ----
PUBLIC_HOST=localhost

# ---- Backup automático do MySQL (serviço db-backup, ativo por padrão) ----
# Gere com: openssl rand -base64 32
# Sem isto, os dumps automáticos saem em texto claro (contêm hashes de senha e
# os shared secrets RADIUS/TACACS+ em claro) — defina sempre em produção.
BACKUP_ENCRYPTION_KEY=change-me-backup-key-base64
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14

# ---- Backup automático agendado por FTP/FTPS (serviço backup-worker) ----
# Servidor, horário, fuso e retenção são configurados no painel
# (Backup e restauração); aqui só a frequência com que o worker consulta a agenda.
BACKUP_WORKER_INTERVAL_SECONDS=30
