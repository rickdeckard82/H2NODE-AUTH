# ─────────────────────────────────────────────────────────────
# Pulse RADIUS — variáveis de ambiente
# Copie para .env e ajuste os valores. NUNCA versione o .env real.
# ─────────────────────────────────────────────────────────────

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=radius
# Usuário usado pelo backend (CRUD completo nas tabelas app_* e radius)
MYSQL_BACKEND_USER=backend_svc
MYSQL_BACKEND_PASSWORD=change-me-backend
# Usuário usado pelo FreeRADIUS (leitura de auth + escrita de accounting)
MYSQL_RADIUS_USER=radius_svc
MYSQL_RADIUS_PASSWORD=change-me-radius

# ---- Redis (storage do rate-limit, compartilhado entre workers) ----
REDIS_PASSWORD=change-me-redis

# ---- Backend (FastAPI) ----
# Chave de assinatura dos JWT — MÍNIMO 32 caracteres (openssl rand -hex 32)
JWT_SECRET=change-me-jwt-secret-32-bytes-hex
# Chave Fernet para cifrar segredos em repouso (radius_secret, mfa_secret)
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-fernet-key-base64
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# URL pública pela qual o painel é acessado (a que o Nginx Proxy Manager publica).
# Usada no CORS. Ex.: https://radius.suaempresa.com.br
FRONTEND_ORIGIN=https://radius.example.com
# Mantenha true: o proxy externo (NPM) entrega HTTPS ao navegador.
COOKIE_SECURE=true
# IP(s) do reverse proxy externo confiável para ler X-Forwarded-*.
# Em produção: use o IP do servidor do NPM (não "*") e configure o NPM para
# SUBSTITUIR o X-Forwarded-For (proxy_set_header X-Forwarded-For $remote_addr).
FORWARDED_ALLOW_IPS=*
# Expor /api/docs e /api/openapi.json. Deixe false em produção.
ENABLE_DOCS=false
LOG_LEVEL=INFO

# ---- Primeiro utilizador do painel (criado pelo seed) ----
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-strong

# ---- FreeRADIUS ----
# Segredo do cliente de teste 127.0.0.1 (radtest local)
RADIUS_TEST_SECRET=testing123
# Os equipamentos apontam para  <IP-privado-do-servidor>:1812 (auth) e :1813 (acct).
# Fixe no IP da interface de gerência para não escutar RADIUS em todas as interfaces.
RADIUS_BIND=0.0.0.0
# BlastRADIUS: "auto" exige Message-Authenticator de quem já envia; "yes" de todos.
RADIUS_REQUIRE_MA=auto

# ---- TACACS+ (tac_plus-ng) ----
# Equipamentos Huawei/Juniper/Datacom que falam TACACS+ apontam para
# <IP-privado-do-servidor>:49/tcp. Fixe no IP de gerência se quiser.
TACACS_BIND=0.0.0.0

# ---- Publicação HTTP (atrás do Nginx Proxy Manager) ----
# Porta em que a aplicação (SPA + /api) escuta no host. Aponte o NPM para
# http://<IP-privado-do-servidor>:${WEB_PORT}
WEB_PORT=8080
# Interface onde publicar. Deixe 0.0.0.0 ou fixe no IP privado do servidor.
WEB_BIND=0.0.0.0

# ---- Proxy TLS embutido (só se usar --profile tls-proxy, sem NPM) ----
PUBLIC_HOST=localhost
