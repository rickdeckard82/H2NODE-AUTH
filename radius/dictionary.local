# ─────────────────────────────────────────────────────────────
# Dicionário local do H2NODE Auth
#
# Huawei, Juniper e Mikrotik já vêm no dicionário padrão do FreeRADIUS.
# Datacom (DmOS) nem sempre acompanha a distribuição — definimos aqui.
#
# IMPORTANTE: confirme o nome/numeração do atributo com o dicionário RADIUS
# da SUA versão de DmOS (Command Reference / arquivo dictionary.datacom do
# fornecedor). Ajuste os VALUE conforme os níveis reais (admin/config/audit).
# O painel permite editar o atributo/valor por perfil sem tocar neste arquivo.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Atributos internos do H2NODE Auth (NUNCA vão no fio — só carregam valor entre
# módulos). O site `default` grava cmd_acct quando `H2NODE-Command` está
# presente. Cisco/genérico (Cisco-AVPair = "cmd=...") já é tratado direto;
# para Huawei / Juniper / Datacom, mapeie o VSA real do SEU firmware para
# `H2NODE-Command` num `update` (ver docs/device-config/*.md) depois de
# confirmar o nome do atributo com `freeradius -X`.
# ─────────────────────────────────────────────────────────────
ATTRIBUTE       H2NODE-Command                  3320    string
ATTRIBUTE       H2NODE-Command-Action           3321    string

# Guarda o IP de origem "real" apurado no site `default` (Calling-Station-Id
# do NAS quando parece um IP válido, senão Packet-Src-IP-Address) para a
# checagem de allowlist por grupo de usuário — ver authorize em sites-available/default.
ATTRIBUTE       H2NODE-Origin-IP                3322    string

# Igual ao H2NODE-Origin-IP, mas só é definido quando o Calling-Station-Id do
# NAS é mesmo um IPv4 válido (sem fallback para Packet-Src-IP-Address). Grava
# o IP do técnico em radpostauth.callingstationid — ver post-auth em
# sites-available/default. Fica indefinido quando o NAS não repassa esse dado.
ATTRIBUTE       H2NODE-Client-IP                3323    string

VENDOR          Datacom                 3709

BEGIN-VENDOR    Datacom

ATTRIBUTE       Datacom-Privilege-Level         1       integer
ATTRIBUTE       Datacom-User-Group              2       string

VALUE   Datacom-Privilege-Level         audit           1
VALUE   Datacom-Privilege-Level         config          10
VALUE   Datacom-Privilege-Level         admin           15

END-VENDOR      Datacom

# ─────────────────────────────────────────────────────────────
# A10 Networks ACOS (Thunder / Thunder CGN — ex.: CGN 1040, 4440).
# O `dictionary.a10` padrão do FreeRADIUS traz os VSA de assinante (AX/ADC),
# mas nem sempre os de acesso administrativo — definimos aqui. Confirme
# nome/numeração e os níveis reais com o guia de "Management Access" da SUA
# release ACOS; o painel permite editar atributo/valor por perfil sem tocar
# neste arquivo.
# ─────────────────────────────────────────────────────────────

VENDOR          A10                     22610

BEGIN-VENDOR    A10

ATTRIBUTE       A10-Admin-Privilege             1       integer
ATTRIBUTE       A10-Admin-Partition             2       string

VALUE   A10-Admin-Privilege             Root            3
VALUE   A10-Admin-Privilege             Partition-EnableDisable 12
VALUE   A10-Admin-Privilege             Read-Only       14

END-VENDOR      A10
